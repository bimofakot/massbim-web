---
import BaseLayout from '@layouts/BaseLayout.astro';
import { site } from '@/config/site';
---

<BaseLayout
  title="Tentang — Massbim"
  description="Tentang Massbim dan pembuatnya."
>
  <section class="pt-4 sm:pt-6">
    <p class="text-xs font-medium uppercase tracking-[0.16em] text-muted">Info</p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-ink sm:text-5xl">Tentang</h1>

    <div class="prose-column mt-6 space-y-4 text-muted">
      <p>
        Saya Bimo Praharbiyanto, developer pemula. Saya belajar sambil membuat tools kecil
        untuk kebutuhan sehari-hari, termasuk untuk usaha GOR badminton.
      </p>
      <p>
        Massbim adalah tempat saya merapikan tools itu. Sebagian sudah bisa dipakai, sebagian
        masih dalam pengembangan. Halaman ini saya perbarui saat ada yang berubah.
      </p>
    </div>
  </section>

  <section class="prose-column mt-12 border-t border-line pt-6" aria-labelledby="info-situs">
    <h2 id="info-situs" class="text-xl font-semibold tracking-tight text-ink">Info situs</h2>

    <dl class="mt-4 divide-y divide-line text-sm">
      <div class="flex flex-wrap justify-between gap-x-6 gap-y-1 py-4">
        <dt class="text-muted">Pemilik</dt>
        <dd class="text-ink">{site.owner}</dd>
      </div>
      <div class="flex flex-wrap justify-between gap-x-6 gap-y-1 py-4">
        <dt class="text-muted">Domain</dt>
        <dd class="text-ink">{site.domain}</dd>
      </div>
      <div class="flex flex-wrap justify-between gap-x-6 gap-y-1 py-4">
        <dt class="text-muted">Fokus</dt>
        <dd class="text-ink">Tools kecil dan website untuk usaha kecil</dd>
      </div>
    </dl>

    <div class="mt-6 flex flex-wrap gap-4">
      <a href="/kontak" class="btn btn-primary">Hubungi saya</a>
      <a href="/jasa" class="btn btn-secondary">Lihat jasa</a>
    </div>
  </section>
</BaseLayout>
