---
import BaseLayout from '@layouts/BaseLayout.astro';
import { site } from '@/config/site';
---

<BaseLayout
  title="Massbim — Katalog tools"
  description="Katalog tools kecil buatan Bimo Praharbiyanto."
>
  <section class="pb-12 pt-4 sm:pt-6">
    <p class="text-xs font-medium uppercase tracking-[0.16em] text-muted">Katalog tools</p>
    <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-ink sm:text-5xl lg:text-6xl">
      Tools kecil untuk kebutuhan sehari-hari.
    </h1>
    <p class="mt-6 max-w-xl text-muted">
      Massbim adalah tempat saya menyimpan tools yang saya buat sendiri. Sebagian sudah bisa
      dipakai, sebagian masih dalam pengembangan.
    </p>
    <div class="mt-6 flex flex-wrap gap-4">
      <a href="#katalog" class="btn btn-primary">Lihat katalog</a>
      <a href="/jasa" class="btn btn-secondary">Jasa pembuatan website</a>
    </div>
  </section>

  <section id="katalog" class="scroll-mt-24" aria-labelledby="katalog-judul">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-t border-line pt-6">
      <h2 id="katalog-judul" class="text-2xl font-semibold tracking-tight text-ink">Katalog</h2>
      <p class="text-sm text-muted">{site.catalog.length} tools, sebagian masih dikembangkan.</p>
    </div>

    <div class="catalog-grid mt-6">
      {site.catalog.map((tool) => (
        <article class="card flex flex-col p-6">
          <div class="flex flex-col items-start gap-2 sm:flex-row sm:items-start sm:justify-between">
            <h3 class="text-xl font-semibold tracking-tight text-ink">{tool.name}</h3>
            <span
              class:list={['status-label', tool.status === 'Aktif' && 'status-label-active']}
            >
              {tool.status}
            </span>
          </div>

          <p class="mt-2 flex-1 text-muted">{tool.summary}</p>

          <div class="mt-6 border-t border-line pt-4 text-sm">
            {tool.url ? (
              <a
                href={tool.url}
                class="font-medium"
                target="_blank"
                rel="noopener"
              >
                {tool.urlLabel ?? tool.url}
              </a>
            ) : (
              <span class="text-muted">Tautan menyusul</span>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="mt-12 sm:mt-24" aria-labelledby="jasa-judul">
    <div class="rounded-card border border-line bg-surface p-6 sm:p-12">
      <p class="text-xs font-medium uppercase tracking-[0.16em] text-muted">Jasa</p>
      <h2 id="jasa-judul" class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
        Butuh website untuk usaha kecil?
      </h2>
      <p class="mt-3 max-w-xl text-muted">
        Saya juga menerima pembuatan website. Halaman jasa berisi penjelasan singkat soal
        pekerjaan yang bisa saya bantu.
      </p>
      <a href="/jasa" class="btn btn-primary mt-6">Lihat halaman jasa</a>
    </div>
  </section>
</BaseLayout>
