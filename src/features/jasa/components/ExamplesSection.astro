---
import type { WorkExample } from '../content';

interface Props {
  eyebrow: string;
  title: string;
  note: string;
  items: WorkExample[];
}

const { eyebrow, title, note, items } = Astro.props;
---

<section class="mt-12 sm:mt-24" aria-labelledby="jasa-contoh">
  <div class="border-t border-line pt-6">
    <p class="text-xs font-medium uppercase tracking-[0.16em] text-muted">{eyebrow}</p>
    <h2 id="jasa-contoh" class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
      {title}
    </h2>
  </div>

  <ul class="mt-6 grid gap-4 sm:grid-cols-2">
    {items.map((item) => (
      <li class="card flex flex-col p-6">
        <div class="flex flex-col items-start gap-2 sm:flex-row sm:items-start sm:justify-between">
          <h3 class="text-xl font-semibold tracking-tight text-ink">{item.name}</h3>
          <span class="status-label">{item.status}</span>
        </div>

        <p class="mt-2 flex-1 text-muted">{item.description}</p>

        <div class="mt-6 border-t border-line pt-4 text-sm">
          {item.href ? (
            <a href={item.href} target="_blank" rel="noopener" class="font-medium">
              {item.hrefLabel}
            </a>
          ) : (
            <span class="text-muted">Tautan menyusul</span>
          )}
        </div>
      </li>
    ))}
  </ul>

  <p class="mt-6 text-sm text-muted">{note}</p>
</section>
