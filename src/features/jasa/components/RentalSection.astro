---
import type { RentalPlan } from '../content';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  tableHead: { plan: string; setup: string; monthly: string };
  plans: RentalPlan[];
  termsTitle: string;
  terms: string[];
  note: string;
}

const { eyebrow, title, intro, tableHead, plans, termsTitle, terms, note } = Astro.props;
---

<section class="mt-12 sm:mt-24" aria-labelledby="jasa-sewa">
  <div class="border-t border-line pt-6">
    <p class="text-xs font-medium uppercase tracking-[0.16em] text-muted">{eyebrow}</p>
    <h2 id="jasa-sewa" class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
      {title}
    </h2>
    <p class="mt-3 max-w-xl text-muted">{intro}</p>
  </div>

  <div class="mt-6 overflow-hidden rounded-card border border-line bg-card">
    <table class="block w-full border-collapse text-left text-sm sm:table">
      <thead class="hidden sm:table-header-group">
        <tr class="border-b border-line">
          <th
            scope="col"
            class="w-1/2 px-6 py-4 text-xs font-medium uppercase tracking-[0.12em] text-muted"
          >
            {tableHead.plan}
          </th>
          <th
            scope="col"
            class="w-1/4 px-6 py-4 text-xs font-medium uppercase tracking-[0.12em] text-muted"
          >
            {tableHead.setup}
          </th>
          <th
            scope="col"
            class="w-1/4 px-6 py-4 text-xs font-medium uppercase tracking-[0.12em] text-muted"
          >
            {tableHead.monthly}
          </th>
        </tr>
      </thead>

      <tbody class="block sm:table-row-group">
        {plans.map((plan) => (
          <tr class="block border-b border-line last:border-b-0 sm:table-row">
            <th
              scope="row"
              class="block px-6 pt-4 text-left text-base font-semibold text-ink sm:table-cell sm:py-4 sm:text-sm sm:font-medium"
            >
              {plan.name}
            </th>
            <td
              class="flex items-baseline justify-between gap-4 px-6 pt-2 sm:table-cell sm:w-1/4 sm:py-4"
            >
              <span class="text-xs text-muted sm:hidden">{tableHead.setup}</span>
              <span class="text-ink">{plan.setup}</span>
            </td>
            <td
              class="flex items-baseline justify-between gap-4 px-6 pb-4 pt-1 sm:table-cell sm:w-1/4 sm:py-4"
            >
              <span class="text-xs text-muted sm:hidden">{tableHead.monthly}</span>
              <span class="font-medium text-ink">{plan.monthly}</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h3 class="mt-6 text-base font-semibold text-ink">{termsTitle}</h3>
  <ul class="mt-3 max-w-3xl border-t border-line text-sm text-muted">
    {terms.map((term) => (
      <li class="border-b border-line py-3">{term}</li>
    ))}
  </ul>

  <p class="mt-6 text-sm text-muted">{note}</p>
</section>
