---
import type { FaqItem } from '../content';

interface Props {
  eyebrow: string;
  title: string;
  items: FaqItem[];
}

const { eyebrow, title, items } = Astro.props;
---

<section class="mt-12 sm:mt-24" aria-labelledby="jasa-faq">
  <div class="border-t border-line pt-6">
    <p class="text-xs font-medium uppercase tracking-[0.16em] text-muted">{eyebrow}</p>
    <h2 id="jasa-faq" class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
      {title}
    </h2>
  </div>

  <dl class="mt-6 border-t border-line">
    {items.map((item) => (
      <div class="border-b border-line py-4 sm:grid sm:grid-cols-[1fr_1.5fr] sm:gap-6">
        <dt class="font-medium text-ink">{item.question}</dt>
        <dd class="mt-1 text-sm leading-relaxed text-muted sm:mt-0">{item.answer}</dd>
      </div>
    ))}
  </dl>
</section>
