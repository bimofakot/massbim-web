---
import type { Service } from '../content';

interface Props {
  intro: { eyebrow: string; title: string };
  services: Service[];
  note: string;
}

const { intro, services, note } = Astro.props;
---

<section class="mt-12 sm:mt-24" aria-labelledby="jasa-layanan">
  <div class="border-t border-line pt-6">
    <p class="text-xs font-medium uppercase tracking-[0.16em] text-muted">{intro.eyebrow}</p>
    <h2 id="jasa-layanan" class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">
      {intro.title}
    </h2>
  </div>

  <ul class="mt-6 grid gap-4 sm:grid-cols-2">
    {services.map((service) => (
      <li id={service.id} class="card flex flex-col p-6">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <h3 class="text-xl font-semibold tracking-tight text-ink">{service.name}</h3>
          <p class="text-sm font-semibold text-ink">{service.price}</p>
        </div>

        {service.priceNote && <p class="text-xs text-muted">{service.priceNote}</p>}

        <p class="mt-3 text-sm leading-relaxed text-muted">{service.audience}</p>

        <ul class="mt-4 list-disc space-y-1 pl-4 text-sm text-muted marker:text-line-strong">
          {service.features.map((feature) => (
            <li>{feature}</li>
          ))}
        </ul>
      </li>
    ))}
  </ul>

  <p class="mt-6 text-sm text-muted">{note}</p>
</section>
