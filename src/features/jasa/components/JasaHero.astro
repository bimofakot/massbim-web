---
import type { Cta } from '../content';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  primaryCta: Cta;
  secondaryCta: Cta;
}

const { eyebrow, title, description, primaryCta, secondaryCta } = Astro.props;
---

<section class="pt-4 sm:pt-6">
  <p class="text-xs font-medium uppercase tracking-[0.16em] text-muted">{eyebrow}</p>
  <h1 class="mt-4 max-w-3xl text-4xl font-bold tracking-tight text-ink sm:text-5xl lg:text-6xl">
    {title}
  </h1>
  <p class="mt-6 max-w-xl text-muted">{description}</p>

  <div class="mt-6 flex flex-wrap gap-4">
    <a
      href={primaryCta.href}
      class="btn btn-primary"
      target={primaryCta.external ? '_blank' : undefined}
      rel={primaryCta.external ? 'noopener' : undefined}
    >
      {primaryCta.label}
    </a>
    <a
      href={secondaryCta.href}
      class="btn btn-secondary"
      target={secondaryCta.external ? '_blank' : undefined}
      rel={secondaryCta.external ? 'noopener' : undefined}
    >
      {secondaryCta.label}
    </a>
  </div>
</section>
