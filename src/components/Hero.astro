---
import Icon from './Icon.astro';

const stats = [
  { value: '20+', label: 'Proyek Selesai' },
  { value: '100%', label: 'Klien Puas' },
  { value: '<3s', label: 'Load Time' },
  { value: '24/7', label: 'Support' },
];

const techBadges = ['React', 'Astro', 'Next.js', 'Tailwind', 'Node.js', 'TypeScript'];
---

<section class="relative container-max pt-8 pb-20">
  <div class="grid lg:grid-cols-2 gap-12 items-center">
    <!-- Left: Content -->
    <div data-animate>
      <div class="badge mb-6">
        <Icon name="sparkles" class="w-3.5 h-3.5" />
        Website yang Bikin Bisnis Tumbuh
      </div>

      <h1 class="font-display font-black text-4xl md:text-5xl lg:text-6xl text-white leading-[1.1] mb-6">
        Wujudkan Website
        <span class="text-gradient">Profesional</span>
        untuk Bisnis Anda
      </h1>

      <p class="text-slate-400 text-lg leading-relaxed mb-8 max-w-xl">
        Saya bantu bisnis Indonesia go digital dengan website cepat, modern, dan
        mengonversi pengunjung jadi pelanggan. Dari Landing Page sampai Custom Web Apps.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 mb-10">
        <a href="/contact" class="btn-primary">
          <Icon name="rocket" class="w-4 h-4" />
          Mulai Proyek Anda
        </a>
        <a href="/portfolio" class="btn-secondary">
          Lihat Hasil Karya
          <Icon name="arrow" class="w-4 h-4" />
        </a>
      </div>

      <!-- Tech stack -->
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs text-slate-500 mr-1">Tech stack:</span>
        {techBadges.map((tech) => (
          <span class="px-2.5 py-1 rounded-lg text-xs font-medium bg-white/5 text-slate-400 border border-white/10">
            {tech}
          </span>
        ))}
      </div>
    </div>

    <!-- Right: Visual -->
    <div class="relative" data-animate data-animate-delay="200">
      <!-- Browser mockup -->
      <div class="relative glass rounded-2xl p-2 shadow-2xl shadow-brand-500/10 animate-float">
        <!-- Browser bar -->
        <div class="flex items-center gap-2 px-3 py-2.5 mb-1">
          <span class="w-3 h-3 rounded-full bg-red-400/70"></span>
          <span class="w-3 h-3 rounded-full bg-amber-400/70"></span>
          <span class="w-3 h-3 rounded-full bg-green-400/70"></span>
          <div class="flex-1 ml-3 px-3 py-1 rounded-lg bg-white/5 text-xs text-slate-500 font-mono">
            https://massbim.my.id
          </div>
        </div>

        <!-- Browser content mockup -->
        <div class="rounded-xl bg-gradient-to-br from-brand-900/40 to-violet-900/30 p-6 overflow-hidden">
          <div class="space-y-4">
            <!-- Mock hero -->
            <div class="space-y-3">
              <div class="h-3 w-20 rounded-full bg-brand-400/40"></div>
              <div class="h-5 w-3/4 rounded-lg bg-white/20"></div>
              <div class="h-5 w-1/2 rounded-lg bg-white/10"></div>
              <div class="h-3 w-2/3 rounded-full bg-slate-500/30"></div>
              <div class="h-3 w-1/2 rounded-full bg-slate-500/20"></div>
            </div>
            <!-- Mock buttons -->
            <div class="flex gap-3 pt-2">
              <div class="h-9 w-28 rounded-xl bg-gradient-to-r from-brand-500 to-violet-500"></div>
              <div class="h-9 w-24 rounded-xl bg-white/10 border border-white/15"></div>
            </div>
            <!-- Mock cards -->
            <div class="grid grid-cols-3 gap-2 pt-4">
              <div class="h-16 rounded-xl bg-white/5 border border-white/10"></div>
              <div class="h-16 rounded-xl bg-white/5 border border-white/10"></div>
              <div class="h-16 rounded-xl bg-white/5 border border-white/10"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Floating badges -->
      <div class="absolute -top-4 -right-4 glass rounded-xl px-4 py-3 shadow-lg animate-float" style="animation-delay: 1s;">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-emerald-500/20 flex items-center justify-center text-emerald-400">
            <Icon name="zap" class="w-4 h-4" />
          </div>
          <div>
            <p class="text-xs text-slate-400">Page Speed</p>
            <p class="text-sm font-bold text-white">98/100</p>
          </div>
        </div>
      </div>

      <div class="absolute -bottom-4 -left-4 glass rounded-xl px-4 py-3 shadow-lg animate-float" style="animation-delay: 2s;">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-amber-500/20 flex items-center justify-center text-amber-400">
            <Icon name="trend" class="w-4 h-4" />
          </div>
          <div>
            <p class="text-xs text-slate-400">Konversi</p>
            <p class="text-sm font-bold text-white">+250%</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats bar -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-16 pt-10 border-t border-white/10" data-animate data-animate-delay="300">
    {stats.map((stat) => (
      <div class="text-center">
        <p class="font-display font-bold text-3xl md:text-4xl text-gradient mb-1">{stat.value}</p>
        <p class="text-slate-400 text-sm">{stat.label}</p>
      </div>
    ))}
  </div>
</section>
