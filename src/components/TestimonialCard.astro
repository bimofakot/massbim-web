---
import Icon from './Icon.astro';
import type { Testimonial } from '@data/testimonials';

interface Props {
  testimonial: Testimonial;
  delay?: string;
}

const { testimonial, delay = '0' } = Astro.props;
---

<div
  class="card-glow p-7 flex flex-col h-full"
  data-animate
  data-animate-delay={delay}
>
  <!-- Stars -->
  <div class="flex gap-1 mb-4 text-amber-400">
    {Array.from({ length: testimonial.rating }).map(() => (
      <Icon name="star" class="w-4 h-4 fill-current" />
    ))}
  </div>

  <!-- Message -->
  <p class="text-slate-300 text-sm leading-relaxed mb-6 flex-grow">
    "{testimonial.message}"
  </p>

  <!-- Author -->
  <div class="flex items-center gap-3 pt-4 border-t border-white/10">
    <div class={`w-11 h-11 rounded-xl bg-gradient-to-br ${testimonial.color} flex items-center justify-center font-display font-bold text-white keep-light`}>
      {testimonial.initial}
    </div>
    <div>
      <p class="text-white font-semibold text-sm">{testimonial.name}</p>
      <p class="text-slate-500 text-xs">{testimonial.role}</p>
    </div>
  </div>
</div>
