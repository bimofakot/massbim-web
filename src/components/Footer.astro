---
import Icon from './Icon.astro';
import { site } from '@data/site';

const year = new Date().getFullYear();

const footerLinks = {
  layanan: [
    { label: 'Landing Page', href: '/services#landing-page' },
    { label: 'Toko Online', href: '/services#toko-online' },
    { label: 'Web UMKM', href: '/services#web-umkm' },
    { label: 'Custom Web Apps', href: '/services#custom-apps' },
  ],
  perusahaan: [
    { label: 'Tentang Kami', href: '/about' },
    { label: 'Portfolio', href: '/portfolio' },
    { label: 'Kontak', href: '/contact' },
    { label: 'Kebijakan Privasi', href: '/privacy' },
  ],
  demo: [
    { label: 'Netflix Clone', href: 'https://netflix.massbim.my.id' },
    { label: 'Blog Pribadi', href: 'https://blog.massbim.my.id' },
  ],
};
---

<footer class="relative mt-24 border-t border-white/10">
  <div class="container-max py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-2.5 mb-5">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-brand-500 to-violet-600 flex items-center justify-center font-display font-bold text-white text-lg keep-light">
            {site.initial}
          </div>
          <span class="font-display font-bold text-xl text-white">
            {site.namePrefix}<span class="text-gradient">{site.nameHighlight}</span>
          </span>
        </a>
        <p class="text-slate-400 text-sm leading-relaxed max-w-xs mb-6">
          Jasa pembuatan website profesional untuk bisnis Indonesia. Cepat, modern, dan terjangkau.
          Mari wujudkan website impian bisnis Anda.
        </p>
        <div class="flex gap-3">
          <a
            href={`https://wa.me/${site.whatsapp.waNumber}`}
            target="_blank"
            rel="noopener"
            class="w-10 h-10 rounded-xl glass glass-hover flex items-center justify-center text-slate-400 hover:text-white"
            aria-label="WhatsApp"
          >
            <Icon name="whatsapp" class="w-5 h-5" />
          </a>
          <a
            href={`mailto:${site.email}`}
            class="w-10 h-10 rounded-xl glass glass-hover flex items-center justify-center text-slate-400 hover:text-white"
            aria-label="Email"
          >
            <Icon name="mail" class="w-5 h-5" />
          </a>
          <a
            href={site.siteUrl}
            class="w-10 h-10 rounded-xl glass glass-hover flex items-center justify-center text-slate-400 hover:text-white"
            aria-label="Website"
          >
            <Icon name="globe" class="w-5 h-5" />
          </a>
        </div>
      </div>

      <!-- Links -->
      <div>
        <h3 class="text-white font-semibold text-sm mb-4">Layanan</h3>
        <ul class="space-y-2.5">
          {footerLinks.layanan.map((link) => (
            <li>
              <a href={link.href} class="text-slate-400 hover:text-brand-300 text-sm transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-white font-semibold text-sm mb-4">Perusahaan</h3>
        <ul class="space-y-2.5">
          {footerLinks.perusahaan.map((link) => (
            <li>
              <a href={link.href} class="text-slate-400 hover:text-brand-300 text-sm transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-white font-semibold text-sm mb-4">Demo Website</h3>
        <ul class="space-y-2.5">
          {footerLinks.demo.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={link.href.startsWith('http') ? 'noopener' : undefined}
                class="text-slate-400 hover:text-brand-300 text-sm transition-colors inline-flex items-center gap-1"
              >
                {link.label}
                <Icon name="arrow-up-right" class="w-3 h-3" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-14 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-slate-500 text-sm">
        &copy; {year} {site.name}.

      </p>
      <p class="text-slate-500 text-xs">
  Powered by <span class="text-amber-500">🍵</span> & <span class="text-purple-400">🎧</span>
      </p>
    </div>
  </div>
</footer>
