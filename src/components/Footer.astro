---
import { site } from '@/config/site';

const waHref = `${site.contact.whatsapp.link}?text=${encodeURIComponent(site.contact.whatsapp.message)}`;

const contacts = [
  { label: 'WhatsApp', value: site.contact.whatsapp.display, href: waHref, external: true },
  { label: 'Email', value: site.contact.email, href: `mailto:${site.contact.email}`, external: false },
  { label: 'Instagram', value: site.contact.instagram.label, href: site.contact.instagram.link, external: true },
  { label: 'GitHub', value: site.contact.github.label, href: site.contact.github.link, external: true },
];
---

<footer class="site-footer">
  <div class="page-container py-12">
    <div class="grid gap-12 sm:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <p class="text-lg font-semibold tracking-tight text-ink">{site.name}</p>
        <p class="mt-2 max-w-xs text-sm leading-relaxed text-muted">
          Katalog tools kecil yang saya buat dan pelihara sendiri.
        </p>
      </div>

      <nav aria-label="Navigasi footer">
        <p class="text-xs font-medium uppercase tracking-[0.14em] text-muted">Navigasi</p>
        <ul class="mt-4 space-y-2 text-sm">
          {site.nav.map((link) => (
            <li>
              <a href={link.href} class="text-muted no-underline hover:text-ink hover:no-underline">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <p class="text-xs font-medium uppercase tracking-[0.14em] text-muted">Kontak</p>
        <ul class="mt-4 space-y-2 text-sm">
          {contacts.map((contact) => (
            <li>
              <a
                href={contact.href}
                class="break-all text-muted no-underline hover:text-ink hover:no-underline"
                target={contact.external ? '_blank' : undefined}
                rel={contact.external ? 'noopener' : undefined}
              >
                {contact.value}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-6 text-sm text-muted">
      <p>© 2026 Massbim</p>
      <a href="/privasi" class="text-muted no-underline hover:text-ink hover:no-underline">Privasi</a>
    </div>
  </div>
</footer>
