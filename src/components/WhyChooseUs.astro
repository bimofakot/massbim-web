---
import Icon from './Icon.astro';

const features = [
  {
    icon: 'zap',
    title: 'Super Cepat',
    desc: 'Website dioptimalkan untuk loading <3 detik. Skor PageSpeed 90+. Karena pengunjung tidak suka menunggu.',
  },
  {
    icon: 'palette',
    title: 'Desain Custom',
    desc: 'Tidak ada template generik. Setiap desain dibuat custom sesuai brand dan target audience bisnis Anda.',
  },
  {
    icon: 'shield',
    title: 'Aman & Reliable',
    desc: 'Dibangun dengan best practices keamanan. HTTPS, data protection, dan kode clean yang teruji.',
  },
  {
    icon: 'globe',
    title: 'SEO Friendly',
    desc: 'Dari struktur HTML sampai meta tags, semuanya dioptimalkan untuk Google dan mesin pencari lainnya.',
  },
  {
    icon: 'heart',
    title: 'Support Berkelanjutan',
    desc: 'Garansi 30 hari setelah launch. Tersedia untuk maintenance bulanan. Website Anda dalam tangan baik.',
  },
  {
    icon: 'users',
    title: 'Komunikasi Transparan',
    desc: 'Progress update berkala. Anda tahu status proyek kapan pun. Tidak ada kejutan, hanya kolaborasi.',
  },
];
---

<section class="container-max my-24">
  <div class="text-center max-w-3xl mx-auto mb-14" data-animate>
    <div class="badge mb-4 mx-auto">
      <Icon name="heart" class="w-3.5 h-3.5" />
      Kenapa Pilih MassBim
    </div>
    <h2 class="font-display font-bold text-3xl md:text-4xl lg:text-5xl text-white leading-tight">
      Bukan Sekadar Website,<br class="hidden md:block" />
      Tapi <span class="text-gradient">Solusi Bisnis</span>
    </h2>
    <p class="mt-5 text-slate-400 text-lg leading-relaxed">
      Saya tidak cuma bikin website cantik. Saya bikin website yang bekerja untuk bisnis Anda.
    </p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
    {features.map((feature, i) => (
      <div
        class="card-glow p-6"
        data-animate
        data-animate-delay={(i % 3) * 100}
      >
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-brand-500/20 to-violet-500/20 border border-brand-400/20 flex items-center justify-center text-brand-300 mb-4">
          <Icon name={feature.icon} class="w-6 h-6" />
        </div>
        <h3 class="font-display font-bold text-lg text-white mb-2">{feature.title}</h3>
        <p class="text-slate-400 text-sm leading-relaxed">{feature.desc}</p>
      </div>
    ))}
  </div>
</section>
