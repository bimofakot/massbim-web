---
import Icon from './Icon.astro';

interface Props {
  title?: string;
  description?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title = 'Siap wujudkan website impian bisnis Anda?',
  description = 'Konsultasi gratis, tanpa komitmen. Ceritakan kebutuhan Anda dan saya buatkan solusi terbaik untuk bisnis Anda.',
  primaryLabel = 'Konsultasi Gratis Sekarang',
  primaryHref = '/contact',
  secondaryLabel = 'Lihat Portfolio',
  secondaryHref = '/portfolio',
} = Astro.props;
---

<section class="container-max my-20">
  <div
    class="relative overflow-hidden rounded-3xl border border-brand-400/20 bg-gradient-to-br from-brand-600/20 via-violet-600/15 to-accent-500/10 backdrop-blur-xl px-8 py-14 md:px-16 md:py-20"
    data-animate
  >
    <!-- Decorative elements -->
    <div class="section-aura" aria-hidden="true"></div>
    <div class="absolute top-0 right-0 w-72 h-72 bg-brand-500/20 rounded-full blur-[100px] -translate-y-1/2 translate-x-1/3"></div>
    <div class="absolute bottom-0 left-0 w-72 h-72 bg-accent-500/15 rounded-full blur-[100px] translate-y-1/2 -translate-x-1/3"></div>

    <div class="relative text-center max-w-2xl mx-auto">
      <div class="badge mb-6 mx-auto">
        <Icon name="sparkles" class="w-3.5 h-3.5" />
        Mulai Hari Ini
      </div>
      <h2 class="font-display font-bold text-3xl md:text-4xl lg:text-5xl text-white leading-tight mb-5">
        {title}
      </h2>
      <p class="text-slate-300 text-base md:text-lg leading-relaxed mb-8">
        {description}
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href={primaryHref} class="btn-primary w-full sm:w-auto">
          <Icon name="send" class="w-4 h-4" />
          {primaryLabel}
        </a>
        <a href={secondaryHref} class="btn-secondary w-full sm:w-auto">
          {secondaryLabel}
          <Icon name="arrow" class="w-4 h-4" />
        </a>
      </div>
    </div>
  </div>
</section>
