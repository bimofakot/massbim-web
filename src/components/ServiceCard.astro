---
import Icon from './Icon.astro';
import type { Service } from '@data/services';

interface Props {
  service: Service;
  delay?: string;
}

const { service, delay = '0' } = Astro.props;
---

<div
  class="card-glow p-7 flex flex-col h-full"
  data-animate
  data-animate-delay={delay}
  id={service.id}
>
  {service.popular && (
    <div class="absolute top-4 right-4 badge text-amber-300 bg-amber-500/10 border-amber-400/20">
      <Icon name="star" class="w-3 h-3" />
      Populer
    </div>
  )}

  <!-- Icon -->
  <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-brand-500/20 to-violet-500/20 border border-brand-400/20 flex items-center justify-center text-brand-300 mb-5">
    <Icon name={service.icon} class="w-7 h-7" />
  </div>

  <!-- Content -->
  <h3 class="font-display font-bold text-xl text-white mb-2">{service.title}</h3>
  <p class="text-slate-400 text-sm leading-relaxed mb-5">{service.shortDesc}</p>

  <!-- Features -->
  <ul class="space-y-2.5 mb-6 flex-grow">
    {service.features.map((feature) => (
      <li class="flex items-start gap-2.5 text-sm text-slate-300">
        <span class="flex-shrink-0 mt-0.5 w-4 h-4 rounded-full bg-brand-500/20 flex items-center justify-center text-brand-400">
          <Icon name="check" class="w-3 h-3" />
        </span>
        {feature}
      </li>
    ))}
  </ul>

  <!-- Price & CTA -->
  <div class="pt-5 border-t border-white/10">
    <p class="text-xs text-slate-500 mb-1">Harga</p>
    <div class="flex items-center justify-between">
      <span class="font-display font-bold text-lg text-gradient">{service.priceRange}</span>
      <a
        href="/contact"
        class="inline-flex items-center gap-1 text-sm font-medium text-brand-300 hover:text-brand-200 transition-colors"
      >
        Pesan
        <Icon name="arrow" class="w-4 h-4" />
      </a>
    </div>
  </div>
</div>
