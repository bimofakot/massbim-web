---
import Icon from './Icon.astro';
import { faqItems } from '@data/testimonials';
---

<section class="container-max my-20">
  <div class="max-w-3xl mx-auto" data-animate>
    <div class="badge mb-4 mx-auto">
      <Icon name="chat" class="w-3.5 h-3.5" />
      FAQ
    </div>
    <h2 class="font-display font-bold text-3xl md:text-4xl text-white text-center mb-4">
      Pertanyaan yang <span class="text-gradient">Sering Ditanyakan</span>
    </h2>
    <p class="text-slate-400 text-center mb-10">
      Belum nemu jawabannya? <a href="/contact" class="text-brand-300 hover:text-brand-200">Tanya langsung saja</a>.
    </p>

    <div class="space-y-3">
      {faqItems.map((item, i) => (
        <details
          class="group glass glass-hover rounded-xl overflow-hidden"
          data-animate
          data-animate-delay={i < 3 ? String((i + 1) * 100) : '0'}
        >
          <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none">
            <span class="font-medium text-white text-sm md:text-base">{item.question}</span>
            <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center text-slate-400 group-open:bg-brand-500/20 group-open:text-brand-300 transition-all">
              <Icon name="plus" class="w-4 h-4 group-open:rotate-45 transition-transform duration-300" />
            </span>
          </summary>
          <div class="px-5 pb-5 text-slate-400 text-sm leading-relaxed">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
