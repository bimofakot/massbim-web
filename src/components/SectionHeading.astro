---
import Icon from './Icon.astro';

interface Props {
  badge?: string;
  badgeIcon?: string;
  title: string;
  highlight?: string;
  description?: string;
  center?: boolean;
}

const { badge, badgeIcon, title, highlight, description, center = true } = Astro.props;
---

<div class={`${center ? 'text-center mx-auto' : 'text-left'} max-w-3xl mb-14`} data-animate>
  {badge && (
    <div class={`badge mb-4 ${center ? 'mx-auto' : ''}`}>
      {badgeIcon && <Icon name={badgeIcon} class="w-3.5 h-3.5" />}
      {badge}
    </div>
  )}
  <h2 class="font-display font-bold text-3xl md:text-4xl lg:text-5xl text-white leading-tight">
    {title} {highlight && <span class="text-gradient">{highlight}</span>}
  </h2>
  {description && (
    <p class="mt-5 text-slate-400 text-base md:text-lg leading-relaxed">
      {description}
    </p>
  )}
</div>
